# Polymarket MoneyMaker V3 paper engine config
# This file is safe to commit. Do NOT put real private keys here.
# Real wallet/private-key values belong in .env.live.secrets, which must NOT be committed.


# =========================
# PAPER ACCOUNT
# =========================
INITIAL_CASH=20
BASE_ORDER_USD=1
MIN_ORDER_USD=1


# =========================
# DATA / DISCOVERY
# =========================
ENABLE_WS=true
HUNTER_MODE=true
MAX_MARKETS=8
EVENT_LIMIT=50
EVENT_PAGES=1
REFRESH_RESEARCH_EVERY=15


# =========================
# MARKET FILTERS
# =========================
MIN_LIQUIDITY=1000
MIN_VOLUME_24H=100
MIN_BEST_BID=0.03
MAX_BEST_ASK=0.97
MAX_SPREAD=0.12
HUNTER_MAX_SPREAD=0.14
HUNTER_MIN_TOP_DEPTH_USD=10
HUNTER_MAX_TOP_DEPTH_USD=1000


# =========================
# RISK LIMITS
# =========================
MAX_POSITION_USD=4
MAX_MARKET_EXPOSURE_USD=5
MAX_TOTAL_EXPOSURE_USD=10
MAX_TOTAL_OPEN_ORDER_USD=4
MAX_OPEN_ORDERS=3
DEDUP_OPEN_ORDERS=true
MAX_OPEN_ORDERS_PER_TOKEN_SIDE_STRATEGY=1
OPEN_ORDER_REPLACE_ENABLED=true
OPEN_ORDER_REPLACE_MIN_PRICE_DELTA_TICKS=1
OPEN_ORDER_REPLACE_AFTER_MS=20000
MAX_DRAWDOWN_PCT=10


# =========================
# SIGNAL QUALITY
# =========================
MIN_SIGNAL_EDGE=0.01
PAPER_CONFIDENCE_PROFILE=balanced
SPREADHUNTER_MIN_CONFIDENCE_PAPER=0.40
MIN_CONFIDENCE=0.45
SLIPPAGE_BUFFER=0.004
ADVERSE_SELECTION_BUFFER=0.006


# =========================
# STOP LOSS / TAKE PROFIT
# =========================
STOP_LOSS_PCT=6
ENABLE_TAKE_PROFIT=true
TAKE_PROFIT_PCT=12


# =========================
# VOLATILITY GUARD
# =========================
VOL_TRIP_PCT=8
VOL_COOLDOWN_MS=180000
VOL_EDGE_MULTIPLIER=2.0
QUOTE_DURING_VOL=false


# =========================
# FILL REALISM / QUEUE REALISM
# =========================
PARTIAL_FILL_DEPTH_FRACTION=0.50
MIN_FILL_USD=0.25
LIQUIDITY_CONSUMED_LIMIT_PCT=0.10
LIQUIDITY_DECAY_POWER=5.0


# =========================
# GHOST ORDER CALIBRATION
# =========================
ENABLE_GHOST_MODE=true
GHOST_HORIZON_MS=60000
GHOST_MAX_RECORDS=500
SPREAD_HUNTER_GHOST_GATE_ENABLED=false
SPREAD_HUNTER_MIN_GHOST_FAVORABLE_PCT=35
SPREAD_HUNTER_GHOST_MIN_SAMPLES=200
SPREAD_HUNTER_GHOST_SIZE_MULTIPLIER=0.35


# =========================
# MULTI-VIEW CONSENSUS / SOPHIE
# =========================
ENABLE_CONSENSUS=true
CONSENSUS_THRESHOLD=0.58
SOPHIE_CONSENSUS=0.10
CONSENSUS_LOG_REJECTED=true
CONSENSUS_BOOST_MAX=1.10
CONSENSUS_PENALTY_MIN=0.65
CONSENSUS_STABLE_MAX_SPREAD=0.10
CONSENSUS_TREND_MOVE_PCT=0.035
CONSENSUS_SNIPER_SIZE_MULTIPLIER=0.50
CONSENSUS_MAKER_BOOST=1.00


# =========================
# MAKER ROUTING
# =========================
TARGET_WALLET_MODE=true
TARGET_WALLET_HANDLE=gabagool22
TARGET_WALLET_DISPLACEMENT_PCT=0.01
MAKER_SPREAD_MULTIPLIER=0.50
ORDER_TTL_MS=180000
PAPER_MAKER_NUDGE_ENABLED=true


# =========================
# ADAPTIVE POSITION SIZING
# =========================
ENABLE_ADAPTIVE_SIZING=true
ADAPTIVE_MIN_SIZE_MULTIPLIER=0.25
ADAPTIVE_MAX_SIZE_MULTIPLIER=1.00
ADAPTIVE_GHOST_PENALTY=0.35


# =========================
# WHALE TRACKING
# =========================
ENABLE_WHALE_TRACKING=true
ENABLE_WHALE_COPY_STRATEGY=false
WHALE_MIN_USD=1000
WHALE_COPY_BASE_MULTIPLIER=0.20
WHALE_COPY_WHALE_FRACTION=0.05


# =========================
# LIVE TRADING SAFETY
# =========================
ENABLE_LIVE_TRADING=false
LIVE_AUTO_EXECUTE=false
LIVE_KILL_SWITCH=true
LIVE_DRY_RUN_ONLY=true
LIVE_SUBMIT_CONFIRM=false

MAX_LIVE_ORDER_USD=1
MAX_LIVE_TOTAL_EXPOSURE_USD=4
LIVE_DAILY_MAX_LOSS_USD=1.50
LIVE_BURN_IN_MAX_DRAWDOWN_PCT=2
LIVE_STALE_ORDER_MS=180000
LIVE_MAX_SPREAD=0.10
LIVE_SOPHIE_MIN_SCORE=0.60


# =========================
# AUTO LIVE CANDIDATES
# =========================
AUTO_LIVE_CANDIDATES_ENABLED=false
AUTO_LIVE_CANDIDATE_COOLDOWN_MS=90000
AUTO_LIVE_MAX_BOOK_AGE_MS=1500
AUTO_LIVE_MIN_CONFIDENCE=0.60
AUTO_LIVE_MIN_GHOST_FAVORABLE_PCT=35


# =========================
# LIVE ROUTER
# =========================
LIVE_ROUTER_ENABLED=true
LIVE_ROUTER_MODE=dry-run
LIVE_ROUTER_MAX_ORDER_USD=1
LIVE_ROUTER_MAX_BURST=1
LIVE_ROUTER_POLL_MS=2500
LIVE_ROUTER_REQUIRE_SOPHIE_APPROVAL=true
LIVE_ROUTER_REQUIRE_FRESH_BOOK=true
LIVE_ROUTER_ALLOW_ORACLE_SIGNALS=false
LIVE_ROUTER_BLOCK_TEST_SIGNALS=true
LIVE_ROUTER_TELEGRAM_NOTIFY=true


