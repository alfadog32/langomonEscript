# Polymarket MoneyMaker V3 paper engine config
# This file is safe to commit. Do NOT put real private keys here.
# Real wallet/private-key values belong in .env.live.secrets, which must NOT be committed.

# =========================
# PAPER ACCOUNT
# =========================
INITIAL_CASH=250
BASE_ORDER_USD=10
MIN_ORDER_USD=3

# =========================
# DATA / DISCOVERY
# =========================
ENABLE_WS=true
HUNTER_MODE=true
MAX_MARKETS=20
EVENT_LIMIT=100
EVENT_PAGES=2
REFRESH_RESEARCH_EVERY=10

# =========================
# MARKET FILTERS
# =========================
MIN_LIQUIDITY=500
MIN_VOLUME_24H=50
MIN_BEST_BID=0.02
MAX_BEST_ASK=0.98
MAX_SPREAD=0.18
HUNTER_MAX_SPREAD=0.22
HUNTER_MIN_TOP_DEPTH_USD=5
HUNTER_MAX_TOP_DEPTH_USD=4000

# =========================
# RISK LIMITS
# =========================
MAX_POSITION_USD=200
MAX_MARKET_EXPOSURE_USD=350
MAX_TOTAL_EXPOSURE_USD=300
MAX_TOTAL_OPEN_ORDER_USD=250
MAX_OPEN_ORDERS=50
DEDUP_OPEN_ORDERS=true
MAX_OPEN_ORDERS_PER_TOKEN_SIDE_STRATEGY=1
OPEN_ORDER_REPLACE_ENABLED=true
OPEN_ORDER_REPLACE_MIN_PRICE_DELTA_TICKS=1
OPEN_ORDER_REPLACE_AFTER_MS=15000
MAX_DRAWDOWN_PCT=12

# Optional live-prep tightening after paper burn-in review:
# MAX_OPEN_ORDERS=10
# MAX_TOTAL_OPEN_ORDER_USD=100

# =========================
# SIGNAL QUALITY
# =========================
MIN_SIGNAL_EDGE=0.008
PAPER_CONFIDENCE_PROFILE=balanced
SPREADHUNTER_MIN_CONFIDENCE_PAPER=0.35
MIN_CONFIDENCE=0.45
PAPER_REALISTIC_FILLS=true
PAPER_FILL_MIN_DELAY_MS=1000
PAPER_FILL_MAX_BOOK_AGE_MS=3000
PAPER_QUEUE_HAIRCUT_PCT=0.50
SLIPPAGE_BUFFER=0.004
ADVERSE_SELECTION_BUFFER=0.006

# =========================
# STOP LOSS / TAKE PROFIT
# =========================
STOP_LOSS_PCT=8
ENABLE_TAKE_PROFIT=true
TAKE_PROFIT_PCT=18

# =========================
# VOLATILITY GUARD
# =========================
VOL_TRIP_PCT=12
VOL_COOLDOWN_MS=5000
VOL_EDGE_MULTIPLIER=1.75
QUOTE_DURING_VOL=false

# =========================
# FILL REALISM / QUEUE REALISM
# =========================
PARTIAL_FILL_DEPTH_FRACTION=0.35
MIN_FILL_USD=1
LIQUIDITY_CONSUMED_LIMIT_PCT=0.20
LIQUIDITY_DECAY_POWER=6.0

# =========================
# GHOST ORDER CALIBRATION
# =========================
ENABLE_GHOST_MODE=true
GHOST_HORIZON_MS=60000
GHOST_MAX_RECORDS=500
SPREAD_HUNTER_GHOST_GATE_ENABLED=false
SPREAD_HUNTER_MIN_GHOST_FAVORABLE_PCT=25
SPREAD_HUNTER_GHOST_MIN_SAMPLES=200
SPREAD_HUNTER_GHOST_SIZE_MULTIPLIER=0.50

# =========================
# MULTI-VIEW CONSENSUS / SOPHIE
# =========================
ENABLE_CONSENSUS=true
CONSENSUS_THRESHOLD=0.55
SOPHIE_CONSENSUS=0.10
CONSENSUS_LOG_REJECTED=true
CONSENSUS_BOOST_MAX=1.15
CONSENSUS_PENALTY_MIN=0.70
CONSENSUS_STABLE_MAX_SPREAD=0.12
CONSENSUS_TREND_MOVE_PCT=0.035
CONSENSUS_SNIPER_SIZE_MULTIPLIER=0.65
CONSENSUS_MAKER_BOOST=1.05

# =========================
# MAKER ROUTING
# =========================
TARGET_WALLET_MODE=true
TARGET_WALLET_HANDLE=gabagool22
TARGET_WALLET_DISPLACEMENT_PCT=0.015
MAKER_SPREAD_MULTIPLIER=1.2

# =========================
# ORDER BOOK IMBALANCE
# =========================
ENABLE_IMBALANCE_SIGNALS=true
IMBALANCE_DEPTH_LEVELS=3
IMBALANCE_STRONG_THRESHOLD=0.10
IMBALANCE_BALANCED_THRESHOLD=0.12

# =========================
# ADAPTIVE POSITION SIZING
# =========================
ENABLE_ADAPTIVE_SIZING=true
ADAPTIVE_MIN_SIZE_MULTIPLIER=0.35
ADAPTIVE_MAX_SIZE_MULTIPLIER=1.35
ADAPTIVE_GHOST_PENALTY=0.65

# Optional live-prep tightening after paper burn-in review:
# ADAPTIVE_GHOST_PENALTY=0.35
# ADAPTIVE_MIN_SIZE_MULTIPLIER=0.15

# =========================
# WHALE TRACKING
# =========================
ENABLE_WHALE_TRACKING=true
ENABLE_WHALE_COPY_STRATEGY=false
WHALE_DATA_API_URL=https://data-api.polymarket.com
WHALE_WALLETS=
# WHALE_WALLETS=comma-separated audited wallets only
WHALE_POLL_MS=30000
WHALE_LOOKBACK_MS=120000
WHALE_MIN_USD=5000
WHALE_TRADES_LIMIT=50
WHALE_API_TIMEOUT_MS=8000
WHALE_BATCH_SIZE=3
WHALE_BATCH_DELAY_MS=1000
WHALE_COPY_FRESH_MS=30000
WHALE_COPY_BASE_MULTIPLIER=0.4
WHALE_COPY_WHALE_FRACTION=0.15

# =========================
# STRATEGIES
# =========================
STRAT_COMPLEMENT_ARB=true
STRAT_SPREAD_HUNTER=true
STRAT_INVENTORY_EXIT=true
STRAT_TAIL_END=true

# =========================
# GABAGOOL BTC ORACLE IMITATION
# =========================
ENABLE_GABAGOOL_BTC_IMITATION=false
GABAGOOL_USERNAME=gabagool22
GABAGOOL_PROXY_WALLET=0x6031b6eed1c97e853c6e0f03ad3ce3529351f96d
GABAGOOL_LOOKBACK_TRADES=500
GABAGOOL_BTC_ONLY=true
GABAGOOL_MAX_PAPER_ORDER_USD=1
GABAGOOL_REQUIRE_ORACLE_SIGNAL=true
GABAGOOL_REQUIRE_SOPHIE=true
GABAGOOL_REQUIRE_RISK=true
GABAGOOL_TELEGRAM_UPDATES=true
GABAGOOL_TELEGRAM_NOTIFY_DETECTED=false
GABAGOOL_TELEGRAM_NOTIFY_PRESOPHIE_BLOCKS=false
GABAGOOL_TELEGRAM_NOTIFY_SOPHIE_BLOCKS=true
GABAGOOL_TELEGRAM_NOTIFY_RISK_BLOCKS=true
GABAGOOL_TELEGRAM_NOTIFY_ORDERS=true
GABAGOOL_TELEGRAM_NOTIFY_FILLS=true
GABAGOOL_TELEGRAM_BLOCK_DEDUPE_MS=60000
GABAGOOL_TELEGRAM_RISK_BLOCK_DEDUPE_MS=120000
GABAGOOL_MAX_PAPER_DRAWDOWN_PCT=2.0
GABAGOOL_MAX_PAPER_CLOSED_LOSS_USD=0.75
GABAGOOL_PAUSE_ENTRIES_ON_LOSS=true
GABAGOOL_MAX_ROUND_TRIPS_PER_TOKEN_PER_MARKET=2
GABAGOOL_REENTER_COOLDOWN_MS=30000
GABAGOOL_ALLOW_DUST_EXITS=true
GABAGOOL_MIN_DUST_EXIT_USD=0.01
GABAGOOL_MIN_PRICE=0.02
GABAGOOL_MAX_ENTRY_PRICE=0.85
GABAGOOL_MAX_PRICE=0.98
GABAGOOL_ALLOW_HIGH_PRICE_ENTRY_EDGE=0.20
GABAGOOL_MIN_CONFIDENCE=0.50
GABAGOOL_MIN_CONFIDENCE_LIVE=0.70
GABAGOOL_MIN_EXPECTED_EDGE=0.0001
ENABLE_BTC_ORACLE_REPORT=true
BTC_ORACLE_REPORT_EVERY_MS=60000
BTC_ORACLE_REPORT_TELEGRAM=false
BTC_ORACLE_REPORT_TELEGRAM_EVERY_MS=300000
GABAGOOL_BEHAVIOR_MODEL_PATH=./gabagool22_btc_behavior_model.json
GABAGOOL_SIGNAL_PATH=./external_signals.json
GABAGOOL_TARGET_PATH=./btc_oracle_market_target.json
GABAGOOL_TELEGRAM_EVENTS_PATH=./gabagool_paper_updates.ndjson

# =========================
# CLOB WEBSOCKET
# =========================
WS_HEARTBEAT_ENABLED=true
WS_TEXT_PING_ENABLED=false
WS_HEARTBEAT_MS=10000
WS_RECONNECT_INITIAL_MS=5000
WS_RECONNECT_MAX_MS=60000
NON_BLOCKING_RESEARCH_REFRESH=true

# =========================
# BTC ORACLE SNIPER BRIDGE
# =========================
SNIPER_BRIDGE_ENABLED=false
SNIPER_REQUIRE_APPROVAL=true
LANGO_APPROVAL_ENDPOINT=http://localhost:18789/approve
LANGO_APPROVAL_TIMEOUT_MS=2500
SNIPER_ROUTE_PATH=./sniper_route_requests.ndjson

# =========================
# LIVE TRADING SAFETY / SECRET FILE ROUTING
# =========================
# Live trading is disabled by default.
# The current MoneyMaker engine remains paper-only unless a separate live adapter is explicitly added and enabled.
ENABLE_LIVE_TRADING=false
LIVE_AUTO_EXECUTE=false
LIVE_KILL_SWITCH=true
LIVE_SECRETS_PATH=./.env.live.secrets
# Default remains paper-only. Stage 5 is the explicit minimum viable manual
# canary profile for Polymarket's 5-share minimum, but it is NOT enabled here.
# To use it later, the operator must explicitly set LIVE_TRADING_STAGE=5 and
# separately choose matching caps such as MAX_LIVE_ORDER_USD=5 and
# MAX_LIVE_TOTAL_EXPOSURE_USD=5. Keep this file safe/off by default.
LIVE_TRADING_STAGE=0
LIVE_CANARY_MARKET_ID=
# Live secret names belong in .env.live.secrets, not here:
# For POLYMARKET_SIGNATURE_TYPE=3, POLYMARKET_FUNDER_ADDRESS should match DEPOSIT_WALLET_ADDRESS.
# POLY_BUILDER_CODE is order attribution only.
# RELAYER_API_KEY* values are for the relayer and are not CLOB API credentials.
DEPOSIT_WALLET_ADDRESS=
POLY_BUILDER_CODE=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
LIVE_ADAPTER_EVENTS_PATH=./live_adapter_events.ndjson
LIVE_EXECUTION_LOG_PATH=./live_execution_events.ndjson
LIVE_RECONCILE_SNAPSHOT_PATH=./live_reconcile_snapshot.json
LIVE_SUBMIT_CONFIRM=false
LIVE_AUTH_CHECK_ALLOW=false
LIVE_SIGNING_TEST_ALLOW=false
LIVE_RECONCILE_ALLOW=false
# These defaults stay conservative even with Stage 5 support present in code.
# A minimum viable manual canary needs explicit runtime overrides and should be
# treated as a plumbing-only profile, not a default operating mode.
MAX_LIVE_ORDER_USD=1
MAX_LIVE_TOTAL_EXPOSURE_USD=10
LIVE_DAILY_MAX_LOSS_USD=3
LIVE_MAX_ORDERS_PER_HOUR=25
LIVE_REQUIRE_SOPHIE_APPROVAL=true
LIVE_REQUIRE_FRESH_BOOK=true
LIVE_REQUIRE_BURN_IN=true
LIVE_BURN_IN_MIN_REPORTS=3
LIVE_BURN_IN_MAX_DRAWDOWN_PCT=3
LIVE_BURN_IN_MIN_CLOSED_PNL_USD=0
LIVE_BURN_IN_MIN_GHOST_FAVORABLE_PCT=0
LIVE_CANCEL_REPLACE_ENABLED=false
LIVE_CANCEL_STALE_ORDERS=true
LIVE_STALE_ORDER_MS=45000
LIVE_REPLACE_MIN_PRICE_DELTA_TICKS=1
LIVE_CANCEL_TEST_ALLOW=false
LIVE_MAX_BOOK_AGE_MS=1500
LIVE_MAX_SPREAD=0.12
LIVE_WHALE_COPY_TRADING=false
LIVE_ALLOW_ORACLE_SNIPER=false
LIVE_DRY_RUN_ONLY=true
LIVE_SOPHIE_MIN_SCORE=0.55

AUTO_LIVE_CANDIDATES_ENABLED=false
AUTO_LIVE_CANDIDATES_PATH=./auto_live_candidates.ndjson
AUTO_LIVE_CANDIDATE_COOLDOWN_MS=45000
AUTO_LIVE_MAX_BOOK_AGE_MS=1500
AUTO_LIVE_MIN_CONFIDENCE=0.55
# If a future manual Stage 5 plumbing canary needs a looser confidence floor,
# set AUTO_LIVE_MIN_CONFIDENCE=0.47 explicitly at runtime. Do not change the
# default here.
AUTO_LIVE_ALLOWED_STRATEGIES=SpreadHunter,InventoryExit,StopLossExit,TakeProfitExit
AUTO_LIVE_BLOCKED_STRATEGIES=ComplementArb,WhaleCopy,TailEndMispricing,GabagoolBtcOracleStrategy
AUTO_LIVE_MIN_GHOST_FAVORABLE_PCT=0

LIVE_ROUTER_ENABLED=true
LIVE_ROUTER_MODE=dry-run
LIVE_ROUTER_WATCH_PATHS=./auto_live_candidates.ndjson
LIVE_ROUTER_EVENTS_PATH=./live_intent_router_events.ndjson
LIVE_ROUTER_STATE_PATH=./live_intent_router_state.json
LIVE_ROUTER_MAX_ORDER_USD=1
LIVE_ROUTER_MAX_BURST=3
LIVE_ROUTER_POLL_MS=2500

LIVE_ALLOWED_SOURCES=MONEYMAKER,BTC_ORACLE
LIVE_ALLOWED_STRATEGIES=SpreadHunter,InventoryExit,StopLossExit,TakeProfitExit,BTC_TEMPORAL_LAG_OBI_V5
LIVE_BLOCKED_STRATEGIES=BTC_TEMPORAL_LAG_OBI_REJECTED,WhaleCopy,ComplementArb,TailEndMispricing,GabagoolBtcOracleStrategy,TEST_APPROVAL

LIVE_ROUTER_REQUIRE_SOPHIE_APPROVAL=true
LIVE_ROUTER_REQUIRE_FRESH_BOOK=true
LIVE_ROUTER_ALLOW_ORACLE_SIGNALS=false
LIVE_ROUTER_BLOCK_TEST_SIGNALS=true
LIVE_ROUTER_TELEGRAM_NOTIFY=true

# =========================
# TELEGRAM APPROVAL RELAY
# =========================
TELEGRAM_APPROVAL_BOT_ENABLED=true
TELEGRAM_APPROVAL_WATCH_PATHS=./trade_intents.ndjson,./sniper_route_requests.ndjson,./auto_live_candidates.ndjson
TELEGRAM_APPROVAL_EVENTS_PATH=./telegram_approval_events.ndjson
TELEGRAM_APPROVAL_STATE_PATH=./telegram_approval_state.json
APPROVAL_DECISIONS_PATH=./approval_decisions.ndjson
TELEGRAM_APPROVAL_FILE_POLL_MS=3000
TELEGRAM_APPROVAL_REQUIRE_TOKEN_ID=false
TELEGRAM_APPROVAL_ALERT_ALL=false
TELEGRAM_APPROVAL_MAX_BURST=5

# =========================
# OPERATOR DASHBOARD
# =========================
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=18888
DASHBOARD_TOKEN=
DASHBOARD_PUBLIC_URL=http://192.168.100.96:18888
